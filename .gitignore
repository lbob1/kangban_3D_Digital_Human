# ---- 密钥与环境变量：严禁提交 ----
.env
.env.*
# 保留示例配置
!.env.example

# ---- Python 缓存与构建产物 ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# ---- 测试与工具缓存 ----
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- IDE ----
.idea/
.vscode/

# ---- 项目外部输入材料（不入库，避免与 docs/ 重复）----
/doc/
/文档一_项目拆解与Day1规划提示词.md
/Day1_3D康伴数字人.md

/.screenshots/

/Day_plan/

# ---- Day3：本地模型与 FunASR 资源（体积大，严禁入库）----
/models/
/funasr-runtime-resources/

# ---- Day5：本地工作缓存与调试产物（含设备 Token/跑批数据，仅留本地）----
/.cache/
/debug/
/tmp/

# ---- 敏感凭证与密钥证书（任何情况下严禁提交）----
*.pem
*.key
*.crt
*.csr
*.pfx
*.p12
*.jks
*.keystore
id_rsa*
id_ed25519*
id_ecdsa*
credentials*.json
*.token
*token.txt
secrets/
.DS_Store

# ---- 数据库文件与备份（本地 pg/SQLite 落盘文件不入库）----
*.db
*.sqlite3
*.dump
*.bak
# Day7：运行时落盘目录（med_checkpoints.sqlite 及 -wal/-shm 等）
/data/

# ---- 日志与临时文件 ----
*.log
*.tmp
*.swp
*.swo
~$*

# ---- 依赖与前端构建（未来引入前端工程时生效）----
node_modules/

# ---- 其他 IDE / 编辑器 ----
.trae/
.history/

# ---- Day7+：用户自备音频素材（版权不入库，仅本地磁盘供演示播放）----
/music/
/yuejv/
/app/static/media/user_*


