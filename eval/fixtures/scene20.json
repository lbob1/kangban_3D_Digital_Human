      "expect": {
        "route_layer": "system_one",
        "intent": "medication",
        "event_status": "confirmed",
        "reply_contains": "已记录",
        "tool_calls_max": 0
      }
    },
    {
      "id": "med-03",
      "category": "medication",
      "title": "「没吃」答复：循环边 retry 回 calling",
      "params": {
        "drug_name": "硝苯地平缓释片",
        "dose": "20mg",
        "slot": "早",
        "slots": [{"time": "08:00", "label": "早"}],
        "reply": "我还没吃"
      },
      "expect": {
        "retry_count": 1,
        "event_status": "waiting_confirm"
      }
    },
    {
      "id": "med-04",
      "category": "medication",
      "title": "离线退避 3 次 → escalated + 漏服工单落库",
      "params": {
        "drug_name": "硝苯地平缓释片",
        "dose": "20mg",
        "slot": "早",
        "slots": [{"time": "08:00", "label": "早"}],
        "offline_recall_times": 3
      },
      "expect": {
        "event_status": "escalated",
        "workorder_created": true,
        "retry_count": 3
      }
    },
    {
      "id": "med-05",
      "category": "medication",
      "title": "「我要吃药」规则接管当日计划播报（零模型）",
      "params": {
        "drug_name": "硝苯地平缓释片",
        "dose": "20mg",
        "slot": "早",
        "slots": [
          {"time": "08:00", "label": "早"},
          {"time": "12:30", "label": "午"}
        ],
        "then_input": "我要吃药"
      },
      "expect": {
        "route_layer": "rule",
        "intent": "medication_confirm",
